apiVersion: v1
kind: ConfigMap
metadata:
  name: backend-config
  namespace: task-manager
data:
  NODE_ENV: "production"
  PORT: "3001"
  JWT_EXPIRES_IN: "7d"
  # Placeholder - the real ALB hostname only exists after M2.4 (Ingress).
  # Update this value once the ALB DNS name is known, or once a custom
  # domain is attached.
  CORS_ORIGIN: "http://k8s-taskmanager-3c184ca188-606630983.eu-west-3.elb.amazonaws.com"
  AWS_REGION: "${aws_region}"
  S3_BUCKET_NAME: "${uploads_bucket_id}"