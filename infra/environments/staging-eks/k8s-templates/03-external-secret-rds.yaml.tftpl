apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: rds-credentials
  namespace: task-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: task-manager-rds-credentials
    creationPolicy: Owner
  data:
    # AWS-managed master user password (manage_master_user_password = true)
    # stores a JSON blob with username/password keys - same format ECS reads
    # via valueFrom = "$${master_user_secret_arn}:username::" in
    # task-definitions.tf. `property` here does the equivalent extraction.
    - secretKey: DB_USERNAME
      remoteRef:
        key: ${rds_secret_arn}
        property: username
    - secretKey: DB_PASSWORD
      remoteRef:
        key: ${rds_secret_arn}
        property: password
