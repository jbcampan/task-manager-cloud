aws_region   = "eu-west-3"
environment  = "staging"
project_name = "task-manager"

tfstate_bucket = "REPLACE_WITH_YOUR_BUCKET_NAME"

vpc_cidr = "10.0.0.0/16"
azs      = ["eu-west-3a", "eu-west-3b"]

public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

backend_container_port  = 3001
frontend_container_port = 3000

# false until an EKS cluster exists, harmless to enable early
eks_ready = false

# Leave empty to skip the SNS email subscription for now
alert_email = ""

cpu_alarm_threshold    = 80
memory_alarm_threshold = 80

db_name              = "taskmanager"
db_username          = "postgres"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_multi_az          = false

# true is convenient while iterating on staging - flip to false before
# anything you actually care about losing goes into this database
db_skip_final_snapshot = true
db_deletion_protection = false