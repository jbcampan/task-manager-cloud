apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: task-manager
  labels:
    app: backend
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
        # Separate from "app: backend" on purpose - that label is also the
        # Service's selector (10-service-backend.yaml). This one exists
        # only so the egress NetworkPolicy can target "anything that
        # talks to RDS/S3", including the one-off migration Job,
        # without accidentally putting that Job's pod into the Service's
        # load-balancing rotation.
        db-access: "true"
    spec:
      serviceAccountName: backend
      # Matches app.enableShutdownHooks() in main.ts - gives NestJS time to
      # close DB connections cleanly on SIGTERM before the pod is killed.
      terminationGracePeriodSeconds: 30
      containers:
        - name: backend
          image: ${backend_image}
          # Tag is a real commit SHA (var.image_tag), not "latest" - see
          # variables.tf for why this isn't auto-resolved. imagePullPolicy:
          # Always is kept regardless: ECR tag mutability for this repo
          # (IMMUTABLE vs MUTABLE) isn't confirmed from here, so this stays
          # the safe default rather than assuming a SHA tag can never be
          # overwritten.
          imagePullPolicy: Always
          ports:
            - containerPort: 3001
          # apps/backend/entrypoint.sh rebuilds DATABASE_URL itself at
          # container start from these 5 values (DB_USERNAME/DB_PASSWORD
          # come from the Secret via envFrom below) and overwrites any
          # DATABASE_URL already in the environment - so these three are
          # required even though the app code never reads them directly.
          env:
            - name: DB_HOST
              value: "${db_host}"
            - name: DB_PORT
              value: "${db_port}"
            - name: DB_NAME
              value: "${db_name}"
          envFrom:
            - configMapRef:
                name: backend-config
            - secretRef:
                name: task-manager-jwt-secret
            - secretRef:
                name: task-manager-rds-credentials
          # Same routes as the ECS ALB health check target group - global
          # prefix "api" + URI versioning "v1" from main.ts both apply to
          # HealthController, so the real path is /api/v1/health/*.
          livenessProbe:
            httpGet:
              path: /api/v1/health/live
              port: 3001
            initialDelaySeconds: 10
            periodSeconds: 15
          readinessProbe:
            httpGet:
              path: /api/v1/health/ready
              port: 3001
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 250m
              memory: 256Mi