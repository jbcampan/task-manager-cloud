apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: jwt-secret
  namespace: task-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: task-manager-jwt-secret
    creationPolicy: Owner
  data:
    # The JWT secret is a plain random string, not a JSON blob - no
    # `property` needed, the whole secret value maps to one key.
    - secretKey: JWT_SECRET
      remoteRef:
        key: ${jwt_secret_arn}