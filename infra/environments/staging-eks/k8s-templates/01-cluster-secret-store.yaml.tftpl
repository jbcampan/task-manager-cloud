apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: aws-secrets-manager
spec:
  provider:
    aws:
      service: SecretsManager
      region: ${aws_region}
      # IRSA - no static credentials. The operator's own ServiceAccount
      # (external-secrets, in the external-secrets namespace) carries the
      # IAM role annotation set by module.external_secrets, scoped
      # read-only to exactly the JWT and RDS secrets.
      auth:
        jwt:
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
